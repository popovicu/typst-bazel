load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//typst:defs.bzl", "typst_document", "typst_library")

# The look, with the font it sets dates in. Any resume could use it.
typst_library(
    name = "style",
    srcs = ["style.typ"],
    fonts = ["@fira_mono//file"],
)

typst_document(
    name = "resume",
    date = "2026-11-21",
    main = "resume.typ",
    deps = [":style"],
)

[sh_test(
    name = "resume_%s_test" % what,
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath resume)",
        "'%s'" % text,
    ],
    data = ["resume"],
) for what, text in {
    "title": "/Title(Resume - Ada Example)",
    "variant": "/Keywords(full)",
    "outline": "/Title(Projects)",
    "font": "+FiraMono-Regular",
    "date": "/CreationDate(D:20261121",
}.items()]

# The same source, told to leave things out.
typst_document(
    name = "short",
    date = "2026-11-21",
    inputs = {"variant": "short"},
    main = "resume.typ",
    deps = [":style"],
)

sh_test(
    name = "short_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath short)",
        "'/Keywords(short)'",
    ],
    data = ["short"],
)

# And as a picture, which works because the resume is one page.
typst_document(
    name = "preview",
    date = "2026-11-21",
    format = "png",
    main = "resume.typ",
    deps = [":style"],
)

sh_test(
    name = "preview_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath preview)",
        "IHDR",
    ],
    data = ["preview"],
)

# And as a web page: the style gives a browser structure, not layout.
typst_document(
    name = "web",
    date = "2026-11-21",
    format = "html",
    main = "resume.typ",
    deps = [":style"],
)

[sh_test(
    name = "web_%s_test" % what,
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath web)",
        "'%s'" % text,
    ],
    data = ["web"],
) for what, text in {
    "name": "<h1>Ada Example</h1>",
    "section": "<h2>Experience</h2>",
    "entry": "<strong>Staff Engineer</strong>, Example Corp",
    "date": "Updated November 21, 2026",
}.items()]
