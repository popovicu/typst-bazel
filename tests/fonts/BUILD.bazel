load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//typst:defs.bzl", "typst_document")

typst_document(
    name = "fira",
    fonts = ["@fira_mono//file"],
    main = "fira.typ",
)

sh_test(
    name = "fira_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath fira)",
        "+FiraMono-Regular",
    ],
    data = ["fira"],
)

typst_document(
    name = "borrowed",
    main = "borrowed.typ",
    deps = ["//tests/fonts/mono"],
)

sh_test(
    name = "borrowed_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath borrowed)",
        "+FiraMono-Regular",
    ],
    data = ["borrowed"],
)
