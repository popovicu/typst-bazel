load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//typst:defs.bzl", "typst_document")

genrule(
    name = "made",
    outs = ["made.json"],
    cmd = "echo '{\"by\": \"a genrule\"}' > $@",
)

typst_document(
    name = "hello",
    srcs = [
        "made.json",
        "parts/part.typ",
        "//tests/shared:shout.typ",
    ],
    main = "hello.typ",
)

sh_test(
    name = "hello_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath hello)",
        "'/Title(PART! a genrule)'",
    ],
    data = ["hello"],
)

# A name that has to be escaped where the rule writes it into Typst.
typst_document(
    name = "quoted",
    main = 'say "hi".typ',
)

sh_test(
    name = "quoted_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath quoted)",
        "'/Title(quoted)'",
    ],
    data = ["quoted"],
)
