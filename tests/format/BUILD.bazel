load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//typst:defs.bzl", "typst_document")

# Each format, and something only a file of that format contains.
FORMATS = {
    "html": "<title>One page</title>",
    "pdf": "/Title(One page)",
    "png": "IHDR",
    "svg": "<svg",
}

[typst_document(
    name = "page_" + format,
    format = format,
    main = "page.typ",
) for format in FORMATS]

[sh_test(
    name = format + "_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath page_%s)" % format,
        "'%s'" % text,
    ],
    data = ["page_" + format],
) for format, text in FORMATS.items()]

typst_document(
    name = "page_coarse",
    format = "png",
    main = "page.typ",
    ppi = 72,
)

# The page is 100 points wide, and a point is a 72nd of an inch.
[sh_test(
    name = name + "_width_test",
    size = "small",
    srcs = ["png_width_test.sh"],
    args = [
        "$(rootpath %s)" % name,
        str(width),
    ],
    data = [name],
) for name, width in [
    ("page_png", 200),
    ("page_coarse", 100),
]]

[typst_document(
    name = "pages_" + format,
    file_per_page = True,
    format = format,
    main = "pages.typ",
) for format in [
    "png",
    "svg",
]]

# Twelve pages, so the numbers are padded to sort in order.
[sh_test(
    name = "pages_%s_test" % format,
    size = "small",
    srcs = ["files_test.sh"],
    args = ["$(rootpath pages_%s)" % format] +
           ["%s.%s" % (("0%d" % page)[-2:], format) for page in range(1, 13)],
    data = ["pages_" + format],
) for format in [
    "png",
    "svg",
]]
