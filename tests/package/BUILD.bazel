load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests:fails_test.bzl", "fails_test")
load("//typst:defs.bzl", "typst_document", "typst_package")

typst_document(
    name = "greets",
    main = "greets.typ",
    deps = ["//tests/package/greet"],
)

sh_test(
    name = "greets_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath greets)",
        "'/Title(hello world)'",
    ],
    data = ["greets"],
)

typst_document(
    name = "asks",
    main = "asks.typ",
    deps = ["//tests/package/polite"],
)

sh_test(
    name = "asks_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath asks)",
        "'/Title(hello world, please)'",
    ],
    data = ["asks"],
)

typst_document(
    name = "letter",
    main = "letter.typ",
    deps = ["//tests/package/letterhead"],
)

sh_test(
    name = "letter_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath letter)",
        "'/Title(hello from the letterhead)'",
    ],
    data = ["letter"],
)

# A manifest by another name, which only ends as typst.toml does.
typst_package(
    name = "odd",
    manifest = "odd/mytypst.toml",
    tags = ["manual"],
    version = "1.0.0",
)

fails_test(
    name = "odd_test",
    size = "small",
    message = "is not a typst.toml",
    target_under_test = "odd",
)
