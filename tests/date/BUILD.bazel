load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests:fails_test.bzl", "fails_test")
load("//typst:defs.bzl", "typst_document")

# A day with no date given, days either side of a leap day, and the ends
# of a year.
DATES = {
    "epoch": None,
    "leap_day": "2024-02-29",
    "after_leap_day": "2024-03-01",
    "new_year": "2026-01-01",
    "new_years_eve": "2099-12-31",
    "century": "2000-02-29",
}

[typst_document(
    name = name,
    date = date,
    main = "today.typ",
) for name, date in DATES.items()]

[sh_test(
    name = name + "_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath %s)" % name,
        "'/Title(%s)'" % (date or "1970-01-01"),
    ],
    data = [name],
) for name, date in DATES.items()]

# Days that are not on the calendar, and one before Typst's dates begin.
NOT_DATES = {
    "february_31": "2026-02-31",
    "leap_day_of_no_leap_year": "2026-02-29",
    "month_13": "2026-13-01",
    "day_0": "2026-05-00",
    "before_1970": "1969-12-31",
    "words": "next Tuesday",
}

[typst_document(
    name = name,
    date = date,
    main = "today.typ",
    tags = ["manual"],
) for name, date in NOT_DATES.items()]

[fails_test(
    name = name + "_test",
    size = "small",
    message = "date",
    target_under_test = name,
) for name in NOT_DATES]
