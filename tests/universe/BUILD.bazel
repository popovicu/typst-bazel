load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//typst:defs.bzl", "typst_document")
load(":imports_test.bzl", "imports_test")

exports_files(["typst.lock.json"])

typst_document(
    name = "formats",
    main = "formats.typ",
    deps = ["@preview//oxifmt:1.0.0"],
)

sh_test(
    name = "formats_test",
    size = "small",
    srcs = ["//tests:pdf_has_test.sh"],
    args = [
        "$(rootpath formats)",
        "'/Title(formatted from Universe)'",
    ],
    data = ["formats"],
)

typst_document(
    name = "diagram",
    main = "diagram.typ",
    deps = ["@preview//fletcher:0.6.0"],
)

sh_test(
    name = "diagram_test",
    size = "small",
    srcs = ["//tests:pdf_has_test.sh"],
    args = [
        "$(rootpath diagram)",
        "'/Title(Drawn)'",
    ],
    data = ["diagram"],
)

imports_test(
    name = "imports_test",
    size = "small",
)

# The lock file is what bazel run @preview//:lock would write.
diff_test(
    name = "lock_test",
    size = "small",
    file1 = "typst.lock.json",
    file2 = "@preview//:typst.lock.json",
)
