load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests:fails_test.bzl", "fails_test")
load("//typst:defs.bzl", "typst_document", "typst_library")
load(":imports_test.bzl", "imports_test", "splits_test")
load(":pins_test.bzl", "pins_test")

exports_files(["typst.lock.json"])

typst_document(
    name = "formats",
    main = "formats.typ",
    deps = ["@preview//oxifmt:1.0.0"],
)

sh_test(
    name = "formats_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath formats)",
        "'/Title(formatted from Universe)'",
    ],
    data = ["formats"],
)

typst_document(
    name = "diagram",
    main = "diagram.typ",
    deps = ["@preview//fletcher:0.6.0"],
)

sh_test(
    name = "diagram_test",
    size = "small",
    srcs = ["//tests:contains_test.sh"],
    args = [
        "$(rootpath diagram)",
        "'/Title(Drawn)'",
    ],
    data = ["diagram"],
)

# fletcher brings cetz, which MODULE.bazel does not ask for.
typst_library(
    name = "names_cetz",
    tags = ["manual"],
    deps = ["@preview//cetz:0.5.3"],
)

fails_test(
    name = "hidden_test",
    size = "small",
    message = "is not visible from",
    target_under_test = "names_cetz",
)

imports_test(
    name = "imports_test",
    size = "small",
)

splits_test(
    name = "splits_test",
    size = "small",
)

pins_test(
    name = "pins_test",
    size = "small",
)

# The lock file is what bazel run @preview//:lock would write.
diff_test(
    name = "lock_test",
    size = "small",
    file1 = "typst.lock.json",
    file2 = "@preview//:typst.lock.json",
)
